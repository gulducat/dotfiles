{
  "cli_default_open_behavior": "new_window",

  /* display */

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Latte"
  },

  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },

  "scrollbar": {
    "git_diff": false,
    "diagnostics": "error",
  },

  "preferred_line_length": 100,
  "wrap_guides": [80, 100, 120],
  "show_wrap_guides": true,
  "soft_wrap": "editor_width",

  "indent_guides": {
    "active_line_width": 2
  },

  "gutter": {
    "git_gutter_width": {"custom": 3}
  },

  "diff_view_style": "unified",

  "inlay_hints": {
    "enabled": true
  },

  "auto_signature_help": true,

  /* interaction */

  "base_keymap": "JetBrains",

  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "on_yank"
  },

  "cursor_animation": {
    "enabled": true
  },

  // fold based on language server
  "document_folding_ranges": "on",

  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 1000,
      "min_column": 80,
    },
  },

  /* ui layout */

  "project_panel": {
    "dock": "left",
    "git_status_indicator": true,
    "indent_guides": {
      "show": "never"
    }
  },
  "outline_panel": {"dock": "left"},
  "git_panel": {"dock": "left"},
  "agent": {
    "dock": "right",
    "threads_sidebar": {
      "position": "right"
    }
  },

  /* misc */

  "auto_install_extensions": {
    "catppuccin-icons": true,
    "make": true,
    "nix": true,
    "lua": true,
    "toml": true,
    "svelte": true,
    "gdscript": true,
    "godot": true,
  }
}
