// https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "bindings": {
      "ctrl-\"": "workspace::ToggleZoom"
    }
  },
  {
    "context": "Workspace || Pane",
    "bindings": {
      "alt-1": "project_panel::Toggle"
    }
  },
  {
    "context": "Workspace || Pane",
    "bindings": {
      "alt-2": "git_panel::Toggle"
    }
  },
  {
    "context": "Workspace || Pane",
    "bindings": {
      "alt-3": "outline_panel::Toggle"
    }
  },
  {
    "context": "!VimControl",
    "bindings": {
      "ctrl-w": "pane::CloseActiveItem"
    }
  },
  {
    "context": "Workspace && (!Terminal || Debugger)",
    "bindings": {
      "ctrl-a k": "workspace::ActivatePaneUp",
      "ctrl-a j": "workspace::ActivatePaneDown",
      "ctrl-a h": "workspace::ActivatePaneLeft",
      "ctrl-a l": "workspace::ActivatePaneRight",
    }
  },
]
