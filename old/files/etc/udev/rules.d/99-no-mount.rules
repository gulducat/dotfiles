# man udev
# udevadm control --reload-rules
# udevadm test /dev/sda
#
# arturia minifuse 2 audio interface
# udevadm info -a -p /sys/class/block/sda
#
# uncomment to log to: journalctl -u systemd-udevd -f
#SUBSYSTEM=="block", ATTRS{manufacturer}=="ARTURIA", OPTIONS="log_level=debug"
ACTION=="add", SUBSYSTEM=="block", ATTRS{manufacturer}=="ARTURIA", RUN{program}="/usr/bin/eject --verbose --scsi %N"

# many experiments below...
